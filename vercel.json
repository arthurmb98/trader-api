{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm --prefix web install",
  "buildCommand": "npm --prefix web run build",
  "outputDirectory": "web/dist",
  "functions": {
    "api/live.py": {
      "maxDuration": 60,
      "excludeFiles": "{web/**,mt5/**,.git/**,datasets/WIN$D*,datasets/*_train.csv,datasets/WINJ*,datasets/WINM*}"
    },
    "api/realtime.py": {
      "maxDuration": 60,
      "excludeFiles": "{web/**,mt5/**,.git/**,datasets/WIN$D*,datasets/*_train.csv,datasets/WINJ*,datasets/WINM*}"
    }
  },
  "rewrites": [
    { "source": "/favicon.ico", "destination": "/brand/logo-branco.png" },
    { "source": "/api/realtime/:op", "destination": "/api/realtime?op=:op" },
    { "source": "/api/live/:op", "destination": "/api/live?op=:op" },
    { "source": "/live", "destination": "/index.html" },
    { "source": "/live/", "destination": "/index.html" },
    { "source": "/replay", "destination": "/index.html" },
    { "source": "/replay/", "destination": "/index.html" },
    { "source": "/ao-vivo", "destination": "/index.html" },
    { "source": "/ao-vivo/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }]
    }
  ]
}
